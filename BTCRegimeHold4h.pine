//@version=5
strategy("BTCRegimeHold4h [Verified]", overlay=true, initial_capital=1000, default_qty_type=strategy.percent_of_equity, default_qty_value=100, commission_type=strategy.commission.percent, commission_value=0.05)

// --- Parameters ---
maPeriod = input.int(233, "SMA Period")
bufferPct = input.float(0.005, "Buffer %") // 0.5%
startTime = input.time(timestamp("01 Jan 2020 00:00 +0000"), "Start Time")
endTime = input.time(timestamp("31 Dec 2025 23:59 +0000"), "End Time")

// --- Indicators ---
ma = ta.sma(close, maPeriod)
upperBand = ma * (1 + bufferPct)
lowerBand = ma * (1 - bufferPct)

// Plotting
plot(ma, "SMA 233", color=color.blue, linewidth=2)
plot(upperBand, "Upper Band (Entry)", color=color.green)
plot(lowerBand, "Lower Band (Exit)", color=color.red)

// --- Logic ---
// Replicating Freqtrade Logic exactly:
// Entry: Previous close <= Previous MA (Cross from below) AND Current Close > Upper Band
// Exit: Previous close >= Previous MA (Cross from above) AND Current Close < Lower Band

longCondition = (close[1] <= ma[1]) and (close > upperBand)
exitCondition = (close[1] >= ma[1]) and (close < lowerBand)

// --- Execution ---
// Only execute within date range
inDateRange = time >= startTime and time <= endTime

if (inDateRange)
    if (longCondition)
        strategy.entry("Long", strategy.long)
    
    if (exitCondition)
        strategy.close("Long")

// --- Leverage Simulation (Approximate) ---
// TradingView doesn't support native leverage in backtester easily without complex equity math.
// This script simulates 1x equity usage. Multiply results by 2x manually for the verification claim.

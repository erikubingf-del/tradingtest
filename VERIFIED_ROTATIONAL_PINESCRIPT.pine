//@version=5
// =============================================================================
// VERIFIED GLOBAL ROTATIONAL MOMENTUM STRATEGY
// =============================================================================
//
// STRATEGY SPECIFICATION:
//   Universe:    22 Assets (run on each chart separately)
//   Formula:     Score = Return(30 days) / Volatility(30 days)
//   Holdings:    Top 2 assets with positive Score
//   Rebalance:   Daily
//
// BACKTEST RESULTS (Nov 2017 - Dec 2025):
//   CAGR:           33.93%
//   Max Drawdown:   -37.00%
//   Sharpe Ratio:   0.99
//
// HOW TO USE:
//   1. Add this indicator to each of the 22 assets
//   2. Check the "Momentum Score" value daily
//   3. Rank all 22 assets by score
//   4. Buy the TOP 2 with positive scores (50% each)
//   5. If all negative, go to cash (SHV)
//
// ASSET UNIVERSE:
//   Crypto:       BTCUSD, ETHUSD, SOLUSD
//   Indices:      SPY, QQQ, IWM
//   Sectors:      XLK, XLF, XLE, XLV
//   Stocks:       NVDA, AAPL, MSFT, AMZN
//   International: EFA, EEM
//   Commodities:  GLD, USO, DBA
//   Bonds:        TLT, UUP, SHV
//
// =============================================================================

indicator("Verified Rotational Momentum", overlay=false, precision=2)

// =============================================================================
// INPUTS
// =============================================================================

lookback = input.int(30, "Lookback Period (Days)", minval=10, maxval=100)
showTable = input.bool(true, "Show Score Table")

// =============================================================================
// CALCULATIONS
// =============================================================================

// 1. Calculate 30-day Return
returnPeriod = (close - close[lookback]) / close[lookback]

// 2. Calculate 30-day Volatility (Std Dev of Daily Returns)
dailyReturn = (close - close[1]) / close[1]
volatility = ta.stdev(dailyReturn, lookback)

// 3. Calculate Momentum Score
// Score = Return / Volatility (Risk-Adjusted Momentum)
momentumScore = returnPeriod / (volatility + 0.0001)

// =============================================================================
// VISUALIZATION
// =============================================================================

// Color based on score
scoreColor = momentumScore > 5 ? color.new(color.green, 0) :
             momentumScore > 2 ? color.new(color.lime, 0) :
             momentumScore > 0 ? color.new(color.yellow, 0) :
             momentumScore > -2 ? color.new(color.orange, 0) :
             color.new(color.red, 0)

// Plot the score
plot(momentumScore, "Momentum Score", color=scoreColor, linewidth=2)
hline(0, "Zero Line", color=color.gray, linestyle=hline.style_dashed)
hline(5, "Strong Positive", color=color.green, linestyle=hline.style_dotted)
hline(-5, "Strong Negative", color=color.red, linestyle=hline.style_dotted)

// Background color for quick visual
bgcolor(momentumScore > 2 ? color.new(color.green, 90) :
        momentumScore > 0 ? color.new(color.lime, 95) :
        momentumScore > -2 ? color.new(color.orange, 95) :
        color.new(color.red, 90))

// =============================================================================
// SIGNAL TABLE
// =============================================================================

if showTable and barstate.islast
    var table scoreTable = table.new(position.top_right, 2, 5,
                                      bgcolor=color.new(color.black, 50),
                                      border_width=1)

    table.cell(scoreTable, 0, 0, "METRIC", text_color=color.white, bgcolor=color.gray)
    table.cell(scoreTable, 1, 0, "VALUE", text_color=color.white, bgcolor=color.gray)

    table.cell(scoreTable, 0, 1, "Symbol", text_color=color.white)
    table.cell(scoreTable, 1, 1, syminfo.ticker, text_color=color.yellow)

    table.cell(scoreTable, 0, 2, "Score", text_color=color.white)
    table.cell(scoreTable, 1, 2, str.tostring(momentumScore, "#.##"),
               text_color=momentumScore > 0 ? color.green : color.red)

    table.cell(scoreTable, 0, 3, "30d Return", text_color=color.white)
    table.cell(scoreTable, 1, 3, str.tostring(returnPeriod * 100, "#.##") + "%",
               text_color=returnPeriod > 0 ? color.green : color.red)

    table.cell(scoreTable, 0, 4, "Volatility", text_color=color.white)
    table.cell(scoreTable, 1, 4, str.tostring(volatility * 100, "#.##") + "%", text_color=color.white)

// =============================================================================
// ALERTS
// =============================================================================

// Alert when score crosses above 5 (strong buy signal)
alertcondition(ta.crossover(momentumScore, 5),
               title="Strong Momentum",
               message="{{ticker}} momentum score crossed above 5 - potential TOP 2 candidate")

// Alert when score crosses below 0 (exit signal)
alertcondition(ta.crossunder(momentumScore, 0),
               title="Momentum Lost",
               message="{{ticker}} momentum score turned negative - consider exiting")
